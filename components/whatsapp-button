"use client"

import { MessageCircle } from "lucide-react"

export function WhatsAppButton() {
  // Número telefónico del vivero en formato internacional (sin el signo + ni guiones)
  const phoneNumber = "+50689413752" // 👈 Reemplaza por tu número real de Costa Rica
  
  // Mensaje predeterminado al abrir el chat
  const defaultMessage = encodeURIComponent(
    "¡Hola Vivero Abunto! 🌱 Me gustaría recibir información y disponibilidad de plantas."
  )

  const whatsappUrl = `https://wa.me/${phoneNumber}?text=${defaultMessage}`

  return (
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      className="fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded-full bg-emerald-600 px-4 py-3 text-white shadow-lg transition-all duration-300 hover:bg-emerald-500 hover:scale-105 hover:shadow-emerald-900/40 backdrop-blur-md border border-emerald-400/20"
    >
      <MessageCircle className="h-6 w-6 fill-current" />
      <span className="hidden font-medium sm:inline">¿Consultas? Escríbenos</span>
    </a>
  )
}
