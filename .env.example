# ==========================================
# 🌿 HORTIADEM ABUNTO - VARIABLES DE ENTORNO
# ==========================================

# 1. Base de datos (NeonDB / PostgreSQL)
# Obtén tu URL de conexión en https://console.neon.tech
# Ejemplo: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. Autenticación (Clerk Auth) - https://dashboard.clerk.com
# Para inicio de sesión, favoritos y protección de rutas
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# 3. Correos y Notificaciones (Resend) - https://resend.com
# Usado para campañas de marketing, promociones y reservas desde el vivero.
# Además, para correos de recuperación de contraseña y bienvenida de Clerk,
# vincula tu clave de Resend en: Clerk Dashboard -> Emails -> Custom Email Provider (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=Hortiadem Abunto <onboarding@resend.dev>

# 4. Administración
# Correos con permisos para gestionar el catálogo y las fichas técnicas
ADMIN_EMAILS=yasircoreassosa@gmail.com

# Modo administrador de desarrollo en vista previa local
ALLOW_DEV_ADMIN=true
